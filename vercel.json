{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install --include=dev",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 10,
      "includeFiles": "{dist/**,src/db/**}"
    },
    "src/app.ts": {
      "memory": 1024,
      "maxDuration": 10,
      "includeFiles": "src/db/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
