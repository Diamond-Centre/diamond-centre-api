# APPLICATION
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# DATABASE
# Local:
# DATABASE_URL=postgres://dice_user:password@localhost:5432/dice_db
# Neon (Dashboard → Connection string → copy "URI"):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://dice_user:password@localhost:5432/dice_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dice_db
DB_USER=dice_user
DB_PASSWORD=password
# Optional: DB_SSL=true  |  DB_SSL_REJECT_UNAUTHORIZED=false

# JWT (use long random strings in production — min 16 chars, not placeholders)
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=change_me_too
REFRESH_TOKEN_EXPIRES_IN=30d

# CORS — comma-separated browser origins (required in production for web clients)
# FRONTEND_ORIGINS=https://your-app.vercel.app
FRONTEND_ORIGINS=

# Payment provider callback shared secret (required in production)
# Send as header: X-Payment-Callback-Secret
PAYMENT_CALLBACK_SECRET=

# Set ENABLE_SWAGGER=true to expose /api-docs in production
ENABLE_SWAGGER=false

# Default super admin (bootstrapped on startup if missing)
DEFAULT_ADMIN_EMAIL=admin@dice.cm
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_NAME=Admin DiCe

# OAuth (optional but recommended in production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# MTN MOMO
MTN_COLLECTION_PRIMARY_KEY=
MTN_COLLECTION_SECONDARY_KEY=
MTN_COLLECTION_USER_ID=
MTN_COLLECTION_API_KEY=
MTN_CALLBACK_URL=

# ORANGE MONEY
OM_CLIENT_ID=
OM_CLIENT_SECRET=
OM_MERCHANT_KEY=
OM_CALLBACK_URL=

# STORAGE (ephemeral on Vercel — prefer cloud storage for production uploads)
UPLOAD_PATH=uploads
# PUBLIC_BASE_URL=https://your-api.vercel.app
