# APPLICATION
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# DATABASE
DATABASE_URL=postgres://dice_user:password@localhost:5432/dice_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dice_db
DB_USER=dice_user
DB_PASSWORD=password

# JWT
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=change_me_too
REFRESH_TOKEN_EXPIRES_IN=30d

# OAuth (optional but recommended in production)
# Comma-separated Google OAuth client IDs (Android / iOS / Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# MTN MOMO
MTN_COLLECTION_PRIMARY_KEY=
MTN_COLLECTION_SECONDARY_KEY=
MTN_COLLECTION_USER_ID=
MTN_COLLECTION_API_KEY=
MTN_CALLBACK_URL=

# ORANGE MONEY
OM_CLIENT_ID=
OM_CLIENT_SECRET=
OM_MERCHANT_KEY=
OM_CALLBACK_URL=

# STORAGE
UPLOAD_PATH=uploads
# Optional override for absolute media URLs (otherwise uses the request Host)
# PUBLIC_BASE_URL=http://192.168.1.112:3001

# QR CODE
QR_CODE_SIZE=300
