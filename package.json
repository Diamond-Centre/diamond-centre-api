{
  "name": "@diamond-centre/api",
  "version": "1.0.0",
  "description": "Diamond Centre REST API - Express.js + PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "build": "npx tsc && mkdir -p dist/db && cp src/db/schema.sql dist/db/schema.sql && cp src/db/seed.sql dist/db/seed.sql",
    "start": "node dist/index.js",
    "db:start": "bash scripts/db-start.sh",
    "db:stop": "bash scripts/db-stop.sh",
    "db:migrate": "ts-node src/db/migrate.ts",
    "db:seed": "ts-node src/db/seed.ts",
    "lint": "eslint src/",
    "test": "jest --passWithNoTests"
  },
  "keywords": [
    "diamond-centre",
    "dice",
    "express",
    "postgresql"
  ],
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "nodemon": "^3.1.9",
    "supertest": "^6.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
